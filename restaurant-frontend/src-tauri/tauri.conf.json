{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartRestaurantPOS",
  "version": "1.0.0",
  "identifier": "com.restaurant.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3005",
    "beforeBuildCommand": "",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "جاري تشغيل النظام...",
        "url": "splash.html",
        "width": 480,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/django_server/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installMode": "perMachine"
      }
    }
  }
}
